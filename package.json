{
  "name": "torob-assistant",
  "version": "4.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "start": "node --max-old-space-size=${NODE_HEAP_MB:-384} --max-semi-space-size=8 server.js",
    "import:pg": "node src/import-pg.js",
    "test": "node --test test/*.test.js",
    "bench": "node --expose-gc scripts/bench.js",
    "bench:memory": "node --expose-gc scripts/bench-memory.js",
    "doctor": "node scripts/doctor.js",
    "ai:check": "node scripts/ai-check.js",
    "ai:mock": "node scripts/mock-ai.js"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "engines": {
    "node": ">=20"
  }
}
