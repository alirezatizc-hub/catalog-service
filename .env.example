# نمونه‌ی متغیرهای محیطی — این فایل کامیت می‌شود ولی هیچ مقدار واقعی‌ای ندارد.
# روی لیارا: پنل اپ → تنظیمات → متغیرهای محیطی. بعد از تغییر، اپ را دوباره دیپلوی/ری‌استارت کنید.

# ───── دیتابیس (لیارا) ─────
# PG_URI=postgresql://user:pass@host:5432/postgres
# یا:
# DATABASE_URL=postgresql://user:pass@host:5432/postgres
# PG_TABLE_PREFIX=
# PGSSLMODE=require

# ───── هوش مصنوعی: BoxAPI ─────
# Base URL رسمی: https://ai.boxapi.ir/ai/v1  ·  مدل: gpt-5.4-mini
BOXAPI_API_KEY=
# BOXAPI_BASE_URL=https://ai.boxapi.ir/ai/v1
# BOXAPI_MODEL=gpt-5.4-mini
# LLM_TIMEOUT_MS=30000
# AI_MAX_TOKENS=700

# ───── اختیاری ─────
# DATA_DIR=./data
# NODE_HEAP_MB=384
# HAY_CACHE=0        # کش متن جست‌وجو را خاموش می‌کند (حافظه کمتر، جست‌وجوی متنی کندتر)   # سقف heap نود؛ برای پلن ۵۱۲MB همین بماند، برای ۱GB+ مثلاً 768
# ETA_MODE=drive
# NESHAN_SERVICE_KEY=
# MAP_TILE_URL=
# CALL_WEBHOOK_URL=
# CALL_WEBHOOK_TOKEN=
# DIAG_TOKEN=
